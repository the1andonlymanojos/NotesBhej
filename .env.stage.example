# Public values are embedded into the browser bundle during docker build.
NEXT_PUBLIC_API_BASE_URL=https://notesbhej-stage.mshiv.net
NEXT_PUBLIC_SITE_URL=https://notesbhej-stage.mshiv.net
NEXT_PUBLIC_APP_ENV=stage
# Browser-restricted Google Maps JavaScript + Places API (New) key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=REPLACE_ME

# Used by server-side rendering and the sitemap during docker build.
# For a host build, use the backend NodePort; for an in-cluster build, use the
# Service DNS name instead.
API_SERVER_BASE_URL=http://127.0.0.1:30008

NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
R2_BUCKET_NAME=REPLACE_ME
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_KEY=REPLACE_ME
