# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.stage.example

# Kubernetes secrets generated from local environment files
k8s/secret.yaml
k8s-stage/secret.yaml
k8s-stage/*secret*.yaml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
public/sitemap-0.xml
.gitignore
public/robots.txt
public/sitemap.xml

certificates

/bin
/lib
pyvenv.cfg
